#!/bin/sh
# A stand-in for an interactive Claude Code or Codex session in tests. It takes Retake's line as its last argument (and
# later lines typed into its terminal), finds the report path in the prompt file the line names, and acts by
# $FAKE_AGENT_MODE: question (asks "Blue or teal?"), edit (waits until $FAKE_BARRIER has two started-* files, makes
# the first shot blue and reports), hang (never reports), exit (quits without a report), or ask and ask-report (asks
# with "$RETAKE_CLI ask", the test binary as retake; ask-report also reports at once; an "Answer to your question"
# line then makes a plain project's next version, a copy of clip_v2.mp4, and reports). Like an interactive agent it
# stays open after its report, until it's killed or $FAKE_LIFELINE disappears. It never calls a provider.
handle() {
	case "$1" in
	*"follow the instructions in "*)
		prompt=${1##*follow the instructions in }
		report=$(grep -o '"[^"]*/report-[0-9]*\.json"' "$prompt" | head -n 1 | tr -d '"')
		output=$(grep -o '"[^"]*/output\.mp4"' "$prompt" | head -n 1 | tr -d '"')
		printf '%s\n%s\n' "$report" "$output" >.fake-agent-task # a typed answer is a new process: it reads them here
		;;
	*)
		report=$(sed -n 1p .fake-agent-task 2>/dev/null)
		output=$(sed -n 2p .fake-agent-task 2>/dev/null)
		;;
	esac
	printf '%s\n' "$1" >>"${FAKE_AGENT_SEEN:-/dev/null}"
	case "${FAKE_AGENT_MODE:-question}" in
	ask | ask-report)
		case "$1" in
		"Answer to your question"*)
			cp clip_v2.mp4 "$output"
			printf '{"state":"completed","message":"Used the answer."}' >"$report"
			;;
		*)
			RETAKE_HELPER=1 "$RETAKE_CLI" -test.run='^TestRetakeHelper$' -- ask --at 1 --box 0.1,0.1,0.5,0.5:"this" "Blue or teal?" \
				>>"${FAKE_AGENT_SEEN:-/dev/null}" 2>&1
			if [ "$FAKE_AGENT_MODE" = ask-report ]; then
				printf '{"state":"completed","message":"Asked which colour."}' >"$report"
			fi
			;;
		esac
		;;
	question)
		printf '{"state":"question","message":"Blue or teal?"}' >"$report"
		;;
	edit)
		: >"$FAKE_BARRIER/started-${PWD##*/}"
		i=0
		while [ "$(find "$FAKE_BARRIER" -name 'started-*' | wc -l)" -lt 2 ]; do
			i=$((i + 1))
			if [ "$i" -gt 600 ]; then
				printf '{"state":"question","message":"No other project was editing at the same time."}' >"$report"
				return
			fi
			sleep 0.1
		done
		sed "s/#aa3322/#2255dd/" edit/timeline.json >edit/timeline.json.new && mv edit/timeline.json.new edit/timeline.json
		printf '{"state":"completed","message":"Made the first shot %s."}' "${SHOT_COLOUR:-blue}" >"$report"
		;;
	exit)
		rm -f "${FAKE_HERDR_DIR:-/nonexistent}/agent-${FAKE_AGENT_NAME:-}"
		exit 0
		;;
	esac
}
for arg; do line=$arg; done # the line is the last argument, after the agent's own flags
handle "$line"
while [ -d "${FAKE_LIFELINE:-/nonexistent}" ]; do
	if IFS= read -r line; then handle "$line"; else sleep 1; fi
done
